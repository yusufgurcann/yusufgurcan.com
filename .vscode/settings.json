{
  // dist/ ve .astro/ build sırasında otomatik üretilir; elle düzenlenmez.
  // Kafa karıştırmasın diye dosya gezgininde gizlenir.
  "files.exclude": {
    "dist": true,
    ".astro": true
  },
  "search.exclude": {
    "dist": true,
    ".astro": true,
    "node_modules": true
  },
  "editor.tabSize": 2,
  "files.associations": {
    "*.astro": "astro"
  }
}
