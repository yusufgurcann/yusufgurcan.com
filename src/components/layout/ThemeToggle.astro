---
import type { Locale } from '@/i18n/locales';
import { useTranslations } from '@/i18n/translate';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<button class="theme-toggle" type="button" aria-label={t('a11y.themeToggle')} aria-pressed="false" data-theme-toggle>
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
    <circle class="theme-toggle__sun" cx="10" cy="10" r="4.2" fill="currentColor"></circle>
    <g class="theme-toggle__rays" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M4 16l1.4-1.4M14.6 5.4 16 4"></path>
    </g>
    <path
      class="theme-toggle__moon"
      d="M16.5 12.3A7 7 0 0 1 7.7 3.5a7 7 0 1 0 8.8 8.8Z"
      fill="currentColor"
    ></path>
  </svg>
</button>

<script>
  import { initThemeToggle } from '@/scripts/theme';
  initThemeToggle();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }

  .theme-toggle:hover {
    border-color: var(--line-strong);
  }

  .theme-toggle__moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__moon {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle__sun,
  :global([data-theme='dark']) .theme-toggle__rays {
    display: none;
  }

  /* The toggle needs JavaScript; hide it when scripts are off. */
  :global(.no-js) .theme-toggle {
    display: none;
  }
</style>
