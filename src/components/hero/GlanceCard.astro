---
/**
 * Hero visual: an "at a glance" index card — a few headings with one-line
 * descriptions, styled like a paper card resting on another.
 * Items fade in one after another (JS on, motion allowed); otherwise shown at once.
 */
import type { Profile } from '@/lib/content';

interface Props {
  glance: Profile['glance'];
}

const { glance } = Astro.props;
---

<figure class="glance">
  <div class="glance__under" aria-hidden="true"></div>

  <div class="glance__card">
    <figcaption class="glance__label caption">
      <span class="glance__pulse" aria-hidden="true"></span>
      {glance.label}
    </figcaption>

    <dl class="glance__items">
      {
        glance.items.map((item, index) => (
          <div class="item" style={`--i:${index}`}>
            <dt class="item__title">{item.title}</dt>
            <dd class="item__description">{item.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</figure>

<style>
  .glance {
    position: relative;
    width: min(100%, 26rem);
    margin: 0;
  }

  /* A second sheet peeking out underneath, slightly turned. */
  .glance__under {
    position: absolute;
    inset: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-sunken);
    transform: rotate(3.5deg) translate(6px, 8px);
  }

  .glance__card {
    position: relative;
    padding: var(--space-l);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transform: rotate(-1.2deg);
    transition: transform var(--duration-m) var(--ease-out);
  }

  .glance:hover .glance__card {
    transform: rotate(0deg) translateY(-3px);
  }

  .glance__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .glance__pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .glance__items {
    display: grid;
    margin-top: var(--space-s);
  }

  .item {
    padding-block: var(--space-m);
    border-top: 1px dashed var(--line);
  }

  .item:last-child {
    padding-bottom: 0;
  }

  .item__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    font-variation-settings: 'SOFT' 60;
    line-height: 1.2;
  }

  .item:first-child .item__title {
    color: var(--accent);
  }

  .item__description {
    margin-top: var(--space-2xs);
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .item {
      animation: rise 520ms var(--ease-out) both;
      animation-delay: calc(250ms + var(--i) * 140ms);
    }

    .glance__pulse {
      animation: pulse 2.2s ease-in-out infinite;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 22%, transparent);
    }
  }
</style>
