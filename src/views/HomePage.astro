---
/**
 * The one-page portfolio, composed from sections. Locale-agnostic:
 * each route under src/pages only decides which locale to render.
 *
 * Order is deliberate: what I've built and done first (projects, experience),
 * then what I bring to a team, then the details.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Projects from '@/components/sections/Projects.astro';
import Journey from '@/components/sections/Journey.astro';
import WhyMe from '@/components/sections/WhyMe.astro';
import Skills from '@/components/sections/Skills.astro';
import Conversation from '@/components/sections/Conversation.astro';
import Education from '@/components/sections/Education.astro';
import Contact from '@/components/sections/Contact.astro';
import { getHomeContent } from '@/lib/content';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { profile, reasons, journey, projects, skills, education, conversation } = await getHomeContent(locale);
const knowsAbout = [...new Set(skills.flatMap((group) => group.items.map((item) => item.name)))];
---

<BaseLayout {locale} jobTitle={profile.role} {knowsAbout}>
  <Hero {locale} {profile} />
  <Projects {locale} {projects} />
  <Journey {locale} stops={journey} />
  <WhyMe {locale} pitch={profile.pitch} {reasons} />
  <Skills {locale} groups={skills} languages={profile.languages} />
  <Conversation {locale} {profile} turns={conversation} />
  <Education {locale} entries={education} />
  <Contact {locale} />
</BaseLayout>
